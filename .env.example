# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/agario_db

# Auth
JWT_SECRET=change-me
ADMIN_USERNAME=your-admin-username

# Solana wallets — main arena (normal Agar/Slither, swept on arena reset)
HOUSE_WALLET_ADDRESS=
HOUSE_WALLET_SECRET=
OWNER_VAULT_ADDRESS=
# Chainstack Solana Mainnet Global Node HTTPS endpoint
SOLANA_RPC_URL=https://solana-mainnet.core.chainstack.com/your-node-access-token

# Battle Royale house wallets — separate pool per variant AND entry fee ($5 / $10)
# NOT swept on arena reset. Generate: node scripts/generate-br-wallets.mjs
BR_AGAR_HOUSE_WALLET_ADDRESS=
BR_AGAR_HOUSE_WALLET_SECRET=
BR_AGAR_10_HOUSE_WALLET_ADDRESS=
BR_AGAR_10_HOUSE_WALLET_SECRET=
BR_SLITHER_HOUSE_WALLET_ADDRESS=
BR_SLITHER_HOUSE_WALLET_SECRET=
BR_SLITHER_10_HOUSE_WALLET_ADDRESS=
BR_SLITHER_10_HOUSE_WALLET_SECRET=

# Reward Pool wallet — separate from house, owner vault, and BR wallets
# Generate: node scripts/generate-reward-wallet.mjs
REWARD_WALLET_ADDRESS=
REWARD_WALLET_SECRET=

# Dev tools — reset arena & sweep house wallet to owner
DEV_RESET_SECRET=change-me-for-local-testing

# Free test play — no real Solana on join/cashout/reset (NEVER enable on production mainnet)
# DEV_FREE_PLAY=true

# Optional: shorten room duration for testing (milliseconds)
# DEV_ROOM_DURATION_MS=300000
# Affiliate / referral program (basis points: 500 = 5%, 3000 = 30%)
PLATFORM_CASHOUT_FEE_BPS=500
AFFILIATE_STANDARD_SHARE_BPS=3000
AFFILIATE_PARTNER_SHARE_BPS=3500
AFFILIATE_TOP_CREATOR_SHARE_BPS=4000
AFFILIATE_HOLD_DAYS=7
AFFILIATE_MIN_PAYOUT_USD=25
REFERRAL_ATTRIBUTION_DAYS=60
# Use a long random secret in production; falls back to JWT_SECRET if omitted.
REFERRAL_HASH_SECRET=

# AGAR token and custodial account swaps. Keep both disabled before launch.
AGAR_TOKEN_ENABLED=false
AGAR_TOKEN_MINT=
AGAR_TOKEN_DECIMALS=9
AGAR_ACCOUNT_SWAP_ENABLED=false
AGAR_SHOP_ENABLED=false
AGAR_TREASURY_ADDRESS=
AGAR_OWNER_REVENUE_ADDRESS=
AGAR_TREASURY_BPS=9000
AGAR_OWNER_BPS=1000
AGAR_SHOP_QUOTE_TTL_SECONDS=60
AGAR_SHOP_MIN_LIQUIDITY_USD=10000
AGAR_MARKET_ENDPOINT=https://api.dexscreener.com/latest/dex/tokens/{mint}
AGAR_CANDLES_ENDPOINT=https://api.geckoterminal.com/api/v2/networks/solana/pools/{pool}/ohlcv/{timeframe}
JUPITER_API_KEY=
JUPITER_SWAP_API_URL=https://api.jup.ag/swap/v2

# 32 random bytes encoded as base64 or 64 hex characters.
# Run migrate:wallet-secrets before enabling AGAR commerce.
WALLET_ENCRYPTION_KEY=
