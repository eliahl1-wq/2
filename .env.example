# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/agario_db

# Auth
JWT_SECRET=change-me
ADMIN_USERNAME=your-admin-username
FRONTEND_URL=https://arenifi.fun
# Production OAuth redirects automatically reject the retired agararena.space frontend.
# Keep this set to the Railway public backend URL unless the API receives its own custom domain.
BACKEND_URL=https://your-backend.railway.app
# Comma-separated extra origins only; Arenifi production, legacy migration and local dev origins are built in.
CORS_ORIGINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Solana wallets — main arena (normal Agar/Slither, swept on arena reset)
HOUSE_WALLET_ADDRESS=
HOUSE_WALLET_SECRET=
OWNER_VAULT_ADDRESS=
# Server-side Solana RPC endpoint (Helius or another provider). Never expose this as VITE_*.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-api-key
# Deduplicate/cache read-only balance synchronization. Financial actions remain fresh.
ACCOUNT_BALANCE_RPC_CACHE_MS=12000
AGAR_BALANCE_RPC_CACHE_MS=30000
# Optional private preview. Leave false for a public launch.
AGAR_ADMIN_ONLY=false
# Normally unnecessary because active clients synchronize through /api/me.
DEPOSIT_BACKGROUND_SCANNER_ENABLED=false
DEPOSIT_SCAN_INTERVAL_MS=60000

# Battle Royale house wallets — separate pool per variant AND entry fee ($5 / $10)
# NOT swept on arena reset. Generate: node scripts/generate-br-wallets.mjs
BR_AGAR_HOUSE_WALLET_ADDRESS=
BR_AGAR_HOUSE_WALLET_SECRET=
BR_AGAR_10_HOUSE_WALLET_ADDRESS=
BR_AGAR_10_HOUSE_WALLET_SECRET=
BR_SLITHER_HOUSE_WALLET_ADDRESS=
BR_SLITHER_HOUSE_WALLET_SECRET=
BR_SLITHER_10_HOUSE_WALLET_ADDRESS=
BR_SLITHER_10_HOUSE_WALLET_SECRET=

# Reward Pool wallet — separate from house, owner vault, and BR wallets
# Generate: node scripts/generate-reward-wallet.mjs
REWARD_WALLET_ADDRESS=
REWARD_WALLET_SECRET=

# Dev tools — reset arena & sweep house wallet to owner
DEV_RESET_SECRET=change-me-for-local-testing

# Free test play — no real Solana on join/cashout/reset (NEVER enable on production mainnet)
# DEV_FREE_PLAY=true

# Optional: shorten room duration for testing (milliseconds)
# DEV_ROOM_DURATION_MS=300000
# Affiliate / referral program (basis points: 800 = 8%, 3000 = 30%)
PLATFORM_CASHOUT_FEE_BPS=800
AFFILIATE_STANDARD_SHARE_BPS=3000
AFFILIATE_PARTNER_SHARE_BPS=3500
AFFILIATE_TOP_CREATOR_SHARE_BPS=4000
AFFILIATE_HOLD_DAYS=7
AFFILIATE_MIN_PAYOUT_USD=2
REFERRAL_ATTRIBUTION_DAYS=60
# Use a long random secret in production; falls back to JWT_SECRET if omitted.
REFERRAL_HASH_SECRET=

# AGAR token and custodial account swaps. Keep both disabled before launch.
AGAR_TOKEN_ENABLED=false
AGAR_TOKEN_MINT=
AGAR_TOKEN_DECIMALS=6
AGAR_TOKEN_NAME=AreniFi Credits
AGAR_TOKEN_SYMBOL=ARC
AGAR_ACCOUNT_SWAP_ENABLED=false
AGAR_SHOP_ENABLED=false
AGAR_TREASURY_ADDRESS=
AGAR_OWNER_REVENUE_ADDRESS=
AGAR_TREASURY_BPS=9000
AGAR_OWNER_BPS=1000
AGAR_SHOP_QUOTE_TTL_SECONDS=60
# Set to 0 to allow a newly launched bonding-curve token. A real quoted market
# pair and usable Jupiter route are still required.
AGAR_SHOP_MIN_LIQUIDITY_USD=0
AGAR_MARKET_ENDPOINT=https://api.dexscreener.com/latest/dex/tokens/{mint}
AGAR_CANDLES_ENDPOINT=https://api.geckoterminal.com/api/v2/networks/solana/pools/{pool}/ohlcv/{timeframe}
JUPITER_API_KEY=
JUPITER_SWAP_API_URL=https://api.jup.ag/swap/v2
# Readiness tests a 0.001 SOL quote without submitting it.
AGAR_READINESS_SWAP_LAMPORTS=1000000

# 32 random bytes encoded as base64 or 64 hex characters.
# Run migrate:wallet-secrets before enabling AGAR commerce.
WALLET_ENCRYPTION_KEY=
# During a key rotation, keep old keys here (comma-separated) until every wallet
# has been re-encrypted. Never replace a lost key: wallets encrypted by it cannot
# be recovered from the database alone.
WALLET_ENCRYPTION_KEY_PREVIOUS=

# Admin exact-mint Pump.fun launch preparation. Keep launch disabled until the
# final manual confirmation. The mint keypair is encrypted in MongoDB.
PINATA_JWT=
PUMP_LAUNCH_ENABLED=false
